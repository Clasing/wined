{
  "name": "@wined/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "migrate": "drizzle-kit migrate",
    "push": "drizzle-kit push"
  },
  "dependencies": {
    "drizzle-orm": "0.33.0",
    "pg": "8.12.0",
    "postgres": "3.4.4"
  },
  "devDependencies": {
    "drizzle-kit": "0.24.2",
    "@types/pg": "8.11.6",
    "typescript": "5.5.4",
    "tsx": "4.19.0"
  }
}
